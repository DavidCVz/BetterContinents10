<Window x:Class="SeedPreviewer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Better Continents · Explorador de semillas" Width="1240" Height="850"
        MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="#11191B" Foreground="#EBEDE7" FontFamily="Segoe UI"
        Closing="WindowClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A9B6AE"/>
        <SolidColorBrush x:Key="Line" Color="#344541"/>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263630"/>
            <Setter Property="Foreground" Value="#F0F3EC"/>
            <Setter Property="BorderBrush" Value="#40534A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A2B88E"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#DDE9C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#16221E"/>
            <Setter Property="Background" Value="#EEF1E8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Border DockPanel.Dock="Right" CornerRadius="14" Padding="12,6"
                    Background="#314335" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="A ACTUAL" FontSize="12" FontWeight="SemiBold" Foreground="#DCECC5"/>
            </Border>
            <StackPanel>
                <TextBlock Text="VALHEIM  /  BETTER CONTINENTS" Style="{StaticResource Caption}"
                           FontWeight="SemiBold" Foreground="#AFC19A"/>
                <TextBlock Text="Explorador de semillas" FontSize="32" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#1B2626" CornerRadius="12" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" Padding="17">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Nuevo mapa" FontSize="20" FontWeight="SemiBold"/>
                        <Label Content="_Semilla" Target="{Binding ElementName=SeedBox}" Foreground="#C4CFC7"
                               Padding="0,16,0,4"/>
                        <DockPanel>
                            <Button x:Name="RandomSeedButton" DockPanel.Dock="Right" Content="Aleatoria"
                                    Margin="7,0,0,0" Padding="9,5" Click="RandomSeedClicked"
                                    AutomationProperties.Name="Generar semilla aleatoria"/>
                            <TextBox x:Name="SeedBox" Text="AbC123" MaxLength="10" Height="35" Padding="8,5"
                                     Background="#EEF1E8" Foreground="#16221E" FontSize="15"
                                     VerticalContentAlignment="Center" AutomationProperties.Name="Semilla"/>
                        </DockPanel>
                        <TextBlock Text="De 1 a 10 letras o números" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        <Label Content="_Preset" Target="{Binding ElementName=PresetBox}" Foreground="#C4CFC7"
                               Padding="0,12,0,4"/>
                        <ComboBox x:Name="PresetBox" AutomationProperties.Name="Preset"/>
                        <Label Content="_Resolución" Target="{Binding ElementName=ResolutionBox}" Foreground="#C4CFC7"
                               Padding="0,12,0,4"/>
                        <ComboBox x:Name="ResolutionBox" AutomationProperties.Name="Resolución">
                            <ComboBoxItem Content="512 × 512 · rápida" Tag="512"/>
                            <ComboBoxItem Content="1024 × 1024 · detalle" Tag="1024" IsSelected="True"/>
                        </ComboBox>
                        <Button x:Name="GenerateButton" Content="Generar mapa" Margin="0,15,0,0"
                                Background="#C6D8A6" Foreground="#19251B" FontWeight="SemiBold" Height="40"
                                IsDefault="True" Click="GenerateClicked"/>
                        <Button x:Name="CancelButton" Content="Cancelar generación" Margin="0,7,0,0"
                                Visibility="Collapsed" Click="CancelClicked"/>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,17,0,13"/>
                        <TextBlock Text="Biomas" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LegendHint" Text="La leyenda aparece con el mapa."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <ItemsControl x:Name="LegendList" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                        <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Swatch}"
                                                Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" CornerRadius="12" Background="#101923" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" Padding="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,0,3,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="FitButton" Content="Ajustar" IsEnabled="False"
                                    Click="FitClicked" Padding="10,5" Margin="0,0,7,0"/>
                            <Button x:Name="SaveButton" Content="Guardar PNG" IsEnabled="False"
                                    Click="SaveClicked" Padding="10,5"/>
                        </StackPanel>
                        <TextBlock x:Name="MapTitle" Text="Vista previa" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <Canvas x:Name="Viewport" Background="Transparent" ClipToBounds="True"
                                SizeChanged="ViewportResized" MouseWheel="ZoomMap" MouseLeftButtonDown="StartPan"
                                MouseLeftButtonUp="EndPan" MouseMove="MovePan" LostMouseCapture="PanLostCapture">
                            <Image x:Name="MapImage" Stretch="Fill" IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Canvas>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False" Margin="20">
                            <TextBlock Text="◎" Foreground="#819786" FontSize="56" HorizontalAlignment="Center"/>
                            <TextBlock Text="Explora una semilla" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Elige el preset y genera el mapa." Style="{StaticResource Caption}"
                                       FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ViewportHelp" Text="Rueda para acercar · Arrastra para mover"
                                   Style="{StaticResource Caption}" Visibility="Collapsed"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="ZoomLabel" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="Abrir resultados" IsEnabled="False"
                    Click="OpenResultsClicked" Padding="10,5" Margin="12,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Listo para generar" Foreground="#BFCBC0"
                           AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
                <ProgressBar x:Name="ProgressBar" Height="3" Margin="0,5,0,0" Visibility="Collapsed"
                             IsIndeterminate="True" Foreground="#BED498" Background="#263630"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
